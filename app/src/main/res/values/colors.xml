<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="warm_white">#FFF4EFE7</color>
    <!-- Acento ámbar Hasselblad (reemplaza el azul que se veía a software) -->
    <color name="accent">#FFFF9E00</color>
    <color name="accent_bright">#FFFFC233</color>
    <color name="brand">#FFFF9E00</color>
    <color name="panel">#B3000000</color>
    <color name="scrim">#CC000000</color>
    <color name="error_bg">#CC2A1500</color>

    <!--
        Tokens de texto del HUD. Antes estaban escritos a mano dentro de CameraActivity
        (Color.parseColor("#CCFFFFFF") y "#8CFFFFFF" repetidos en catorce sitios):
        cambiar el contraste obligaba a tocar catorce líneas de Kotlin y siempre se
        quedaba alguna sin cambiar, así que la barra superior nunca era homogénea.
        text_primary es blanco pleno porque el 80% de blanco sobre una escena quemada
        no llegaba al 4,5:1 que el jurado midió como criterio de aceptación.
    -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_dim">#E6FFFFFF</color>
    <color name="text_off">#99FFFFFF</color>
    <!--
        Aquí vivió un cuarto escalón, text_faint (#8CFFFFFF), para "apagado pero no
        desactivado". Se retiró: no lo usaba nadie y no había a quién dárselo. Su único
        consumidor posible eran las paradas de zoom digital de highlightZoomStrip(), que
        van con text_off, y el salto de #99 (60% de blanco) a #8C (55%) no se distingue a
        ojo mientras que sí baja el contraste de unas CIFRAS que hay que leer sobre el
        visor en vivo. Tres escalones (primary / dim / off) son los que el HUD sabe
        distinguir de verdad. Si vuelve a hacer falta, que vuelva con su consumidor
        escrito en el mismo cambio.
    -->

    <!--
        Verde y rojo del anillo de enfoque. Los anteriores (#4CD964 y #FF3B30) eran
        literalmente la paleta de iOS y chocaban con el ámbar de la app. Estos están
        desplazados hacia el cálido para convivir con el acento.
    -->
    <color name="focus_ok">#FF6FD68C</color>
    <color name="focus_fail">#FFFF6B4A</color>

    <!--
        Superficies del HUD: dos niveles de elevación de la misma familia.
        surface_chip venía del 40% de negro (los chips desaparecían sobre fondo claro) y
        pasó al 60%, pero al 60% seguía sin llegar: medido sobre una pared blanca quemada,
        el ÁMBAR del chip activo (#FFFF9E00) daba 2,77:1 sobre ese fondo, muy por debajo
        del 4,5:1 exigible, y el ámbar es justo lo que dice qué ajuste está puesto.
        Al 80% el mismo par sube a 6,10:1 y el texto blanco a 10,6:1. Se queda por debajo
        de surface_panel (85%) a propósito, para conservar los dos niveles de elevación.
    -->
    <color name="surface_chip">#CC000000</color>
    <color name="surface_panel">#D9000000</color>
    <color name="hairline">#33FFFFFF</color>
    <!-- Ámbar al 18%: fondo de la parada de zoom seleccionada. -->
    <color name="accent_soft">#2EFF9E00</color>
    <!--
        Ámbar al 10% con filo al 50%: parada de zoom MÁS CERCANA cuando el pellizco deja
        el zoom entre paradas. Tiene que leerse como "por aquí andas" sin confundirse con
        el "estás exactamente aquí" del state_selected, que va al 18% con filo pleno.
    -->
    <color name="accent_faint">#1AFF9E00</color>
    <color name="accent_edge">#80FF9E00</color>

    <!--
        Cuarto nivel de superficie: PANEL QUE DECIDE. El jurado midió que a través del
        panel "⋯" se leían a la vez la pastilla de lente y la escena de detrás, y que por
        eso el panel de HDR/RAW/proporción era ilegible sobre escena clara.
        La cuenta: con surface_panel (85% de negro) sobre una pared quemada de 255 el panel
        se pinta a 0,15 x 255 = 38/255, que es exactamente el rango en el que un texto
        blanco de debajo sigue siendo legible. Al 96% baja a 10/255, por debajo del 12/255
        que el propio jurado midió y describió como "visor completamente en negro".
        NO sustituye a surface_panel: las pastillas (zoom, cronómetro, bloqueo AE/AF) se
        quedan al 85% a propósito, porque esas flotan sobre la imagen y no deben taparla.
    -->
    <color name="surface_panel_solid">#F5000000</color>

    <!--
        Medidor de audio. El jurado midió la toma entregada a -50,6 dBFS de media y
        -28,7 dBTP de pico "sin que el usuario tuviera forma alguna de saberlo mientras
        grababa". Tres tramos, y los tres tienen que distinguirse de reojo sobre el visor
        en vivo: verde = hay señal y va holgada, ámbar = zona de trabajo (-12..-6 dBFS),
        rojo = satura. Se reutilizan focus_ok/focus_fail para no meter un verde y un rojo
        nuevos en una paleta que ya tenía dos.
    -->
    <color name="meter_track">#33FFFFFF</color>
    <color name="meter_ok">#FF6FD68C</color>
    <color name="meter_peak">#FFFF9E00</color>
    <color name="meter_clip">#FFFF6B4A</color>

    <!-- Botón de WhatsApp junto a FOTO/VIDEO. El verde de la marca a plena opacidad
         rompía la paleta cálida de la app (fue la queja del botón verde anterior), así
         que va al 35% sobre la franja de control, con un aro claro para que se despegue
         igual de bien sobre una escena oscura que sobre uno clara. -->
    <color name="wa_soft">#5925D366</color>
    <color name="wa_stroke">#8C25D366</color>
</resources>
