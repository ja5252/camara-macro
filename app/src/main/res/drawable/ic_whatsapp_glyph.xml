    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Bocadillo con la cola abajo a la izquierda, simétrico: los dos flancos cierran
         a la misma altura (y=11.3) para que no salga escorado a 20dp. -->
