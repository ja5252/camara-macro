<?xml version="1.0" encoding="utf-8"?>
<!--
    Versión ACTIVA de la pastilla (nivel 2 de la escala 8 / 16 / 28dp): mismo lenguaje
    que el chip activo (chip_bg con state_selected) y que la parada de zoom seleccionada
    (zoom_stop_bg), pero con el radio de pastilla en vez del radio de chip.

    Existe como drawable suelto, y no como estado de zoom_pill_bg, porque quien la pone
    es el código en una vista que NO tiene estado seleccionado: la pastilla del nivel de
    zoom se enciende y se apaga sola con una animación de alpha.

    El fondo es 85% de negro bajo el lavado ámbar del 18%: sobre una escena quemada, el
    texto ámbar sobre el 80% se queda en 4,36:1 y sobre el 85% sube a 5,12:1.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_panel" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
