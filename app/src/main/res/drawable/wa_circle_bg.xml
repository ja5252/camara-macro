<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del botón de WhatsApp que vive junto a FOTO/VIDEO.

    Semitransparente a propósito: va superpuesto a la franja de control, al lado del
    selector de modo, y tiene que reconocerse de un vistazo sin robarle protagonismo al
    obturador. Un verde opaco de marca rompía la paleta (fue justo la queja del botón
    verde anterior); a ~35% de opacidad se lee como "acción de compartir" y se queda en
    su sitio. El aro claro lo despega de cualquier escena, oscura o clara.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/wa_soft" />
    <stroke
        android:width="1.5dp"
        android:color="@color/wa_stroke" />
</shape>
