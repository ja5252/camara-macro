<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. Vista previa -->
    <com.pepe.camaramacro.AutoFitTextureView
        android:id="@+id/texture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- 2. Capa de gestos (tap = enfoque, pellizco = zoom) -->
    <View
        android:id="@+id/gesture_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cuadrícula + nivel (no recibe toques) -->
    <com.pepe.camaramacro.GridOverlayView
        android:id="@+id/grid_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 3. Scrims para legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:clickable="false"
        android:focusable="false" />

    <!-- 4. Anillo de enfoque (se mueve al punto del tap) -->
    <View
        android:id="@+id/focus_ring"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:clickable="false"
        android:focusable="false"
        android:visibility="invisible" />

    <!-- 5. Píldora de zoom -->
    <TextView
        android:id="@+id/zoom_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="156dp"
        android:background="@drawable/zoom_pill_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:text="1.0x"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />

    <!-- 6. Chip de lente activa -->
    <TextView
        android:id="@+id/lens_chip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="@string/lens_macro"
        android:textAllCaps="true"
        android:textColor="@color/warm_white"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:clickable="false"
        android:focusable="false" />

    <!-- 7. Cambiar lente (engrane) -->
    <ImageButton
        android:id="@+id/btn_change_lens"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/change_lens"
        android:padding="11dp"
        android:src="@drawable/ic_settings" />

    <!-- 8. Miniatura de última foto -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/thumbnail"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="46dp"
        app:cardBackgroundColor="#22FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#B3FFFFFF"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/thumbnail_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_thumbnail"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 9. Obturador -->
    <ImageButton
        android:id="@+id/btn_shutter"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/shutter_button"
        android:contentDescription="@string/shutter"
        android:elevation="6dp" />

    <!-- Selector de modo FOTO / VIDEO -->
    <LinearLayout
        android:id="@+id/mode_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="134dp"
        android:background="@drawable/zoom_pill_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tab_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mode_photo"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tab_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mode_video"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Indicador de grabación -->
    <TextView
        android:id="@+id/rec_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="54dp"
        android:background="@drawable/zoom_pill_bg"
        android:drawableStart="@drawable/rec_dot"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="0:00"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Punto/cuadro de video sobre el obturador -->
    <View
        android:id="@+id/shutter_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:background="@drawable/rec_dot"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Toggle PRO -->
    <TextView
        android:id="@+id/pro_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="70dp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="PRO"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- Panel PRO -->
    <LinearLayout
        android:id="@+id/pro_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="188dp"
        android:background="@drawable/zoom_pill_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pro_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="EV 0"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/pro_slider"
            android:layout_width="288dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip_ev" style="@style/ProChip" android:text="EV" />
            <TextView android:id="@+id/chip_iso" style="@style/ProChip" android:text="ISO" />
            <TextView android:id="@+id/chip_vel" style="@style/ProChip" android:text="VEL" />
            <TextView android:id="@+id/chip_wb" style="@style/ProChip" android:text="WB" />
            <TextView android:id="@+id/chip_auto" style="@style/ProChip" android:text="AUTO" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chips arriba-izquierda: cuadrícula y temporizador -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="44dp"
        android:orientation="vertical">

        <TextView android:id="@+id/chip_grid" style="@style/ProChip" android:layout_marginBottom="6dp" android:text="⊞" />
        <TextView android:id="@+id/chip_timer" style="@style/ProChip" android:layout_marginBottom="6dp" android:text="⏱ off" />
        <TextView android:id="@+id/chip_flash" style="@style/ProChip" android:layout_marginBottom="6dp" android:text="⚡ off" />
        <TextView android:id="@+id/chip_flip" style="@style/ProChip" android:layout_marginBottom="6dp" android:text="⟲ atrás" />
    </LinearLayout>

    <!-- Cuenta atrás del temporizador -->
    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text=""
        android:textColor="@color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:shadowColor="#B3000000"
        android:shadowRadius="12"
        android:visibility="gone" />

    <!-- 10. Destello de captura (encima de todo, no recibe toques) -->
    <View
        android:id="@+id/screen_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
