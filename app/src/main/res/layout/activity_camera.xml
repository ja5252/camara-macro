<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================================
    HUD ANCLADO AL VISOR, NO A LA PANTALLA
    ============================================================================
    Esto era un FrameLayout plano con 28 hijos colocados por márgenes absolutos
    (24/30/40/54/64/96/102/110/116/120/184/190/244dp). De ahí salían casi todos los
    defectos que encontró la auditoría, y todos por la misma causa:

      · zoom_pill, pro_panel, lens_panel, video_panel y ev_quick compartían
        EXACTAMENTE marginBottom=244dp, así que se dibujaban unos encima de otros y
        la exclusión se intentaba a mano con ifs ("if (proOn) togglePro()"). ev_quick
        se colaba igual en cada toque de enfoque: dos sliders superpuestos.
      · more_panel (176dp a todo el ancho, y=96..272dp) tapaba lens_chip (102..128),
        ae_lock_badge (120..152) y magnifier_card (120..240), y como era el último del
        XML se dibujaba encima de los tres: con el panel abierto la lupa "no funcionaba".
      · rec_indicator (54..85dp) quedaba debajo de options_bar (40..88dp) y el
        cronómetro salía mordido durante la grabación.
      · grid_overlay era match_parent de la RAÍZ: con la imagen en 351x624dp dentro de
        una caja de 351x758dp, los tercios se pintaban a 289 px de donde están.
      · countdown, qr_card y night_label usaban layout_gravity=center de la RAÍZ: con
        relación 1:1 aparecían ENTEROS sobre la franja negra, fuera de la foto.
      · screen_flash era match_parent de la raíz y el fogonazo delataba dónde acaba
        el encuadre parpadeando también la franja negra.

    Ahora hay TRES piezas y ningún margen del HUD se mide desde el borde de la pantalla:

      1. preview_frame  → el visor y TODO lo que debe ir pegado a la imagen.
         Es un PreviewFrameLayout: coloca a sus hijos sobre el RECTÁNGULO VISIBLE de
         la imagen, no sobre la pantalla. Cuadrícula, anillo, chip de lente, lupa,
         cuenta atrás, tarjeta QR y destello viven aquí dentro.
      2. top_bar       → apila (no superpone) barra de opciones y cronómetro.
      3. control_band  → panel_slot, zoom, FOTO/VIDEO y la fila del obturador,
         en una columna con un ritmo único. Su fondo ES el degradado inferior, así
         que crece y encoge con la banda en vez de ser una franja fija de 190dp.
    ============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ==================== 1. VISOR ==================== -->
    <com.pepe.camaramacro.PreviewFrameLayout
        android:id="@+id/preview_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- La gravedad la fija CameraActivity según coverMode: CENTER cuando el visor
             llena la pantalla (si no, el recorte se comía el 42% SOLO por abajo) y
             TOP|CENTER_HORIZONTAL cuando muestra el fotograma entero. -->
        <com.pepe.camaramacro.AutoFitTextureView
            android:id="@+id/texture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- Fotograma congelado que tapa el negro mientras cambia la lente física.
             Es decorativo: TalkBack lo anunciaba como "Ver última foto" porque
             reciclaba el contentDescription de la miniatura. -->
        <ImageView
            android:id="@+id/lens_fade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Todo lo que va PEGADO A LA IMAGEN. PreviewFrameLayout lo mide y lo coloca
             exactamente sobre el rectángulo visible del fotograma. -->
        <FrameLayout
            android:id="@+id/preview_hud"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Capa de gestos: toque = enfoque, pellizco = zoom, doble toque = zoom
                 rápido, pulsación larga = bloqueo AE/AF. Ahora ocupa la imagen y no la
                 pantalla entera, así que un toque en la franja negra ya no intenta
                 enfocar fuera del encuadre. -->
            <View
                android:id="@+id/gesture_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_viewfinder"
                android:focusable="true" />

            <com.pepe.camaramacro.GridOverlayView
                android:id="@+id/grid_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

            <!-- Degradado superior anclado al VISOR y dimensionado por contenido: tiene
                 que cubrir la barra de opciones ENTERA y el chip de lente que va justo
                 debajo. Medía 110dp cuando lens_chip llegaba a 128dp, así que el chip
                 quedaba fuera de su protección. Va aquí dentro, antes del chip, para
                 que oscurezca la imagen y NO el texto que tiene que proteger. -->
            <View
                android:id="@+id/scrim_top_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/scrim_top_height"
                android:layout_gravity="top"
                android:background="@drawable/scrim_top"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

            <!-- Chip de lente: pegado al vértice superior izquierdo DE LA IMAGEN.
                 Con layout_gravity contra la pantalla se salía del visor en el
                 plegable y el texto flotaba sobre la franja negra. -->
            <TextView
                android:id="@+id/lens_chip"
                style="@style/Hud.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="@dimen/hud_top_offset"
                android:background="@drawable/chip_bg"
                android:clickable="false"
                android:ellipsize="end"
                android:focusable="false"
                android:maxLines="1"
                android:maxWidth="@dimen/lens_chip_max_width"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/lens_macro"
                android:textColor="@color/warm_white" />

            <TextView
                android:id="@+id/ae_lock_badge"
                style="@style/Hud.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/hud_top_offset"
                android:layout_marginEnd="14dp"
                android:background="@drawable/zoom_pill_bg"
                android:clickable="false"
                android:focusable="false"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="@string/ae_af_locked"
                android:textColor="@color/accent"
                android:visibility="gone" />

            <!-- Lupa de confirmación de nitidez. CameraActivity la manda al cuadrante
                 OPUESTO al dedo: pegada siempre arriba a la derecha tapaba justo lo
                 que el usuario acababa de tocar en esa esquina. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/magnifier_card"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="top|end"
                android:layout_marginStart="14dp"
                android:layout_marginTop="@dimen/hud_top_offset"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="20dp"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/magnifier"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:id="@+id/focus_ring"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/focus_ring"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <!-- Ranura central ÚNICA: cuenta atrás, tarjeta QR y aviso de apilado
                 compartían el mismo centro de la PANTALLA, así que un QR detectado
                 durante la cuenta atrás tapaba el número. Ahora se centran en la
                 IMAGEN y solo puede haber uno visible a la vez. -->
            <FrameLayout
                android:id="@+id/center_slot"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_countdown"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#B3000000"
                    android:shadowRadius="14"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="88sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/night_label"
                    style="@style/Hud.Data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/panel_bg"
                    android:clickable="false"
                    android:drawableStart="@drawable/ic_night"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/accent"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="14dp"
                    android:text="@string/night_stacking"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/qr_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/qr_text"
                        style="@style/Hud.Data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="4"
                        android:maxWidth="@dimen/panel_max_width"
                        android:text="" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_qr_copy"
                            style="@style/ProChip.Action"
                            android:contentDescription="@string/cd_qr_copy"
                            android:text="Copiar" />

                        <TextView
                            android:id="@+id/btn_qr_open"
                            style="@style/ProChip.Action"
                            android:contentDescription="@string/cd_qr_open"
                            android:text="Abrir" />

                        <TextView
                            android:id="@+id/btn_qr_close"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_qr_close"
                            android:text="Cerrar" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Aviso DISCRETO de código detectado. La tarjeta QR saltaba al centro del
                 visor en cuanto entraba cualquier código en cuadro, tapando al sujeto
                 mientras el usuario componía. Ahora solo aparece esta pastilla y la
                 tarjeta se despliega si se toca. -->
            <TextView
                android:id="@+id/qr_hint"
                style="@style/Hud.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="72dp"
                android:background="@drawable/chip_action_bg"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_min"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/qr_detected"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Aviso efímero. Sustituye a los más de 20 Toast, que en la pantalla
                 grande salían abajo del todo, lejísimos del chip recién tocado. -->
            <TextView
                android:id="@+id/hint_pill"
                style="@style/Hud.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/hint_pill_bg"
                android:clickable="false"
                android:focusable="false"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:text=""
                android:visibility="gone" />

            <!-- El destello vive DENTRO del visor: en la pantalla de cubierta con 16:9
                 parpadeaban también 134dp de barra negra (407dp con 1:1). -->
            <View
                android:id="@+id/screen_flash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@color/white"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </com.pepe.camaramacro.PreviewFrameLayout>

    <!-- ==================== 2. BARRA SUPERIOR ==================== -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        android:paddingTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Con scroll: ya se cortó un chip por el borde derecho en una captura. -->
        <HorizontalScrollView
            android:id="@+id/options_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/options_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_flash"
                    style="@style/ProChip.Icon"
                    android:drawableStart="@drawable/ic_flash_off"
                    android:text="" />

                <TextView
                    android:id="@+id/chip_timer"
                    style="@style/ProChip.Icon"
                    android:drawableStart="@drawable/ic_timer"
                    android:text="" />

                <TextView
                    android:id="@+id/chip_grid"
                    style="@style/ProChip.Icon"
                    android:drawableStart="@drawable/ic_grid"
                    android:text="" />

                <TextView
                    android:id="@+id/chip_night"
                    style="@style/ProChip.Icon"
                    android:drawableStart="@drawable/ic_night"
                    android:text="" />

                <TextView
                    android:id="@+id/chip_more"
                    style="@style/ProChip.Icon"
                    android:drawableStart="@drawable/ic_more"
                    android:contentDescription="@string/cd_more"
                    android:text="" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Fila propia: antes options_bar se declaraba después y se dibujaba ENCIMA
             del cronómetro, que salía mordido durante toda la grabación. -->
        <TextView
            android:id="@+id/rec_indicator"
            style="@style/Hud.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/zoom_pill_bg"
            android:contentDescription="@string/cd_rec_time"
            android:drawableStart="@drawable/rec_dot"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="0:00"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ==================== 3. BANDA DE CONTROLES ==================== -->
    <LinearLayout
        android:id="@+id/control_band"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/scrim_bottom"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Ranura ÚNICA de paneles: la exclusión mutua es estructural (showPanel deja
             visible uno y esconde el resto), no una lista de ifs a mano que ev_quick
             se saltaba en cada toque de enfoque. -->
        <FrameLayout
            android:id="@+id/panel_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Exposición rápida. Era match_parent con un SeekBar de 48dp EN PLENA
                 IMAGEN durante 4 s: cualquier toque para enfocar dentro de esa franja
                 movía la exposición en vez de enfocar. Aquí abajo ya no roba toques. -->
            <LinearLayout
                android:id="@+id/ev_quick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/panel_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ev_label"
                    style="@style/Hud.Value"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0.0 EV"
                    android:textColor="@color/accent" />

                <SeekBar
                    android:id="@+id/ev_slider"
                    android:layout_width="@dimen/panel_slider_width"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/cd_ev_slider"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pro_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/panel_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pro_value"
                    style="@style/Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EV 0"
                    android:textColor="@color/accent" />

                <SeekBar
                    android:id="@+id/pro_slider"
                    android:layout_width="@dimen/panel_slider_width"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/cd_pro_slider"
                    android:max="100"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <!-- Ancho EXACTO igual al del slider: con match_parent dentro de un
                     LinearLayout wrap_content el hijo se mide a pantalla completa y el
                     panel se estiraba de borde a borde. -->
                <HorizontalScrollView
                    android:layout_width="@dimen/panel_slider_width"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_ev"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_ev"
                            android:text="EV" />

                        <TextView
                            android:id="@+id/chip_iso"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_iso"
                            android:text="ISO" />

                        <TextView
                            android:id="@+id/chip_vel"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_vel"
                            android:text="VEL" />

                        <TextView
                            android:id="@+id/chip_wb"
                            style="@style/ProChip"
                            android:text="WB" />

                        <TextView
                            android:id="@+id/chip_k"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_kelvin"
                            android:text="K" />

                        <TextView
                            android:id="@+id/chip_auto"
                            style="@style/ProChip.Action"
                            android:contentDescription="@string/cd_auto"
                            android:text="AUTO" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lens_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/panel_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/video_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/panel_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chip_vres"
                    style="@style/ProChip"
                    android:text="1080p" />

                <TextView
                    android:id="@+id/chip_vfps"
                    style="@style/ProChip"
                    android:text="30fps" />

                <TextView
                    android:id="@+id/chip_vcodec"
                    style="@style/ProChip"
                    android:text="H264" />

                <TextView
                    android:id="@+id/chip_tl"
                    style="@style/ProChip.Icon"
                    android:drawableStart="@drawable/ic_timelapse"
                    android:text="TL" />
            </LinearLayout>

            <!-- Panel "Más": estaba anclado ARRIBA con marginTop=96dp, inalcanzable con
                 el pulgar en 2480 px de alto y tapando el visor. Ahora está abajo, con
                 secciones con nombre y cada fila con scroll propio (la tercera fila
                 medía ~354dp en 351dp disponibles y se comía el botón de lentes). -->
            <LinearLayout
                android:id="@+id/more_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    style="@style/Hud.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/sec_image" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_hdr"
                            style="@style/ProChip"
                            android:text="@string/chip_hdr" />

                        <TextView
                            android:id="@+id/chip_raw"
                            style="@style/ProChip"
                            android:text="@string/chip_raw" />

                        <TextView
                            android:id="@+id/chip_ratio"
                            style="@style/ProChip"
                            android:text="" />

                        <TextView
                            android:id="@+id/chip_res"
                            style="@style/ProChip"
                            android:text="@string/chip_full" />

                        <TextView
                            android:id="@+id/chip_filter"
                            style="@style/ProChip.Icon"
                            android:drawableStart="@drawable/ic_filter"
                            android:text="" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    style="@style/Hud.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/sec_lenses" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_lenses"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_lenses"
                            android:text="@string/chip_lenses" />

                        <TextView
                            android:id="@+id/chip_flip"
                            style="@style/ProChip.Icon"
                            android:drawableStart="@drawable/ic_rotate"
                            android:text="" />

                        <!-- Solo aparece si el sistema publica de verdad la pantalla
                             externa del plegable. -->
                        <TextView
                            android:id="@+id/chip_mirror"
                            style="@style/ProChip.Icon"
                            android:drawableStart="@drawable/ic_mirror"
                            android:text="@string/mirror"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/btn_change_lens"
                            android:layout_width="@dimen/touch_min"
                            android:layout_height="@dimen/touch_min"
                            android:layout_marginHorizontal="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/pick_another_lens"
                            android:padding="11dp"
                            android:src="@drawable/ic_settings" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    style="@style/Hud.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/sec_tools" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pro_toggle"
                            style="@style/ProChip"
                            android:text="@string/chip_pro" />

                        <TextView
                            android:id="@+id/chip_vid"
                            style="@style/ProChip.Icon"
                            android:contentDescription="@string/cd_vid"
                            android:drawableStart="@drawable/ic_movie"
                            android:text=""
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chip_wa"
                            style="@style/ProChip"
                            android:contentDescription="@string/cd_wa"
                            android:text="@string/chip_wa" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>

        <!-- Indicador de zoom: fila propia. Estaba a la misma cota que los cuatro
             paneles y por debajo de ellos, así que al pellizcar con un panel abierto
             el nivel de zoom era sencillamente invisible. -->
        <TextView
            android:id="@+id/zoom_pill"
            style="@style/Hud.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:background="@drawable/zoom_pill_bg"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:text="1.0x" />

        <!-- Tira de zoom con scroll: con 6 paradas pedía 360dp sobre 351dp de pantalla
             y se recortaba por los DOS lados, escondiendo justo el gran angular y el
             teleobjetivo. Las píldoras se construyen por código, todas del mismo
             tamaño exacto (@dimen/zoom_stop_width). -->
        <HorizontalScrollView
            android:id="@+id/zoom_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/zoom_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/zoom_pill_bg"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_photo"
                style="@style/ModeTab"
                android:contentDescription="@string/cd_mode_photo"
                android:text="@string/mode_photo"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tab_video"
                style="@style/ModeTab"
                android:contentDescription="@string/cd_mode_video"
                android:text="@string/mode_video"
                android:textColor="@color/text_off" />
        </LinearLayout>

        <!-- Fila del obturador. Los tres controles se alinean por CENTRO VERTICAL
             (antes sus centros caían en 57, 58 y 63dp: 6dp de desnivel a simple vista
             en la fila que más se mira) y con el mismo margen a los dos lados (eran
             24dp y 22dp). En sw600dp el margen crece a 150dp: con 26dp la miniatura y
             el botón de voltear quedaban a 592dp, unos 118 mm, imposibles de alcanzar
             con el pulgar. -->
        <FrameLayout
            android:id="@+id/shutter_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/thumbnail"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="@dimen/action_row_side_margin"
                android:contentDescription="@string/cd_thumbnail"
                android:focusable="true"
                app:cardBackgroundColor="#22FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#B3FFFFFF"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/thumbnail_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btn_flip_main"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/action_row_side_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_lens"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flip_camera" />

            <!-- El punto/cuadro de video iba a marginBottom=64dp y el obturador a 24dp:
                 sus centros quedaban a 79dp y 63dp, o sea 16dp descolocado, mordiendo
                 el anillo superior. Envolviéndolos los dos centran por construcción. -->
            <FrameLayout
                android:id="@+id/shutter_wrap"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center">

                <ImageButton
                    android:id="@+id/btn_shutter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shutter_button"
                    android:contentDescription="@string/shutter" />

                <View
                    android:id="@+id/shutter_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/rec_dot"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
