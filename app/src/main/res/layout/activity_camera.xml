<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. Vista previa (proporción real; franja inferior para controles) -->
    <com.pepe.camaramacro.AutoFitTextureView
        android:id="@+id/texture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" />

    <!-- 2. Capa de gestos (tap = enfoque, pellizco = zoom) -->
    <View
        android:id="@+id/gesture_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cuadrícula + nivel (no recibe toques) -->
    <com.pepe.camaramacro.GridOverlayView
        android:id="@+id/grid_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 3. Scrims para legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:clickable="false"
        android:focusable="false" />

    <!-- 4. Anillo de enfoque (se mueve al punto del tap) -->
    <View
        android:id="@+id/focus_ring"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_ring"
        android:clickable="false"
        android:focusable="false"
        android:visibility="invisible" />

    <!-- 5. Píldora de zoom -->
    <TextView
        android:id="@+id/zoom_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="236dp"
        android:background="@drawable/zoom_pill_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:text="1.0x"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />

    <!-- 6. Chip de lente activa -->
    <TextView
        android:id="@+id/lens_chip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="@string/lens_macro"
        android:textAllCaps="true"
        android:textColor="@color/warm_white"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        android:clickable="false"
        android:focusable="false" />

    <!-- 8. Miniatura de última foto -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/thumbnail"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="46dp"
        app:cardBackgroundColor="#22FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#B3FFFFFF"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/thumbnail_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_thumbnail"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón WhatsApp: toma foto y la comparte por WhatsApp -->
    <ImageButton
        android:id="@+id/btn_whatsapp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="45dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/share_whatsapp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_whatsapp" />

    <!-- 9. Obturador -->
    <ImageButton
        android:id="@+id/btn_shutter"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/shutter_button"
        android:contentDescription="@string/shutter"
        android:elevation="6dp" />

    <!-- Selector de modo FOTO / VIDEO -->
    <LinearLayout
        android:id="@+id/mode_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="134dp"
        android:background="@drawable/zoom_pill_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tab_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mode_photo"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tab_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/mode_video"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Indicador de grabación -->
    <TextView
        android:id="@+id/rec_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="54dp"
        android:background="@drawable/zoom_pill_bg"
        android:drawableStart="@drawable/rec_dot"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="0:00"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Punto/cuadro de video sobre el obturador -->
    <View
        android:id="@+id/shutter_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:background="@drawable/rec_dot"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Panel PRO -->
    <LinearLayout
        android:id="@+id/pro_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="240dp"
        android:background="@drawable/zoom_pill_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pro_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="EV 0"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/pro_slider"
            android:layout_width="288dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip_ev" style="@style/ProChip" android:text="EV" />
            <TextView android:id="@+id/chip_iso" style="@style/ProChip" android:text="ISO" />
            <TextView android:id="@+id/chip_vel" style="@style/ProChip" android:text="VEL" />
            <TextView android:id="@+id/chip_wb" style="@style/ProChip" android:text="WB" />
            <TextView android:id="@+id/chip_k" style="@style/ProChip" android:text="K" />
            <TextView android:id="@+id/chip_auto" style="@style/ProChip" android:text="AUTO" />
        </LinearLayout>
    </LinearLayout>

    <!-- Panel de lentes (activar/desactivar en el ciclo de zoom) -->
    <LinearLayout
        android:id="@+id/lens_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="240dp"
        android:background="@drawable/zoom_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- Panel de ajustes de video -->
    <LinearLayout
        android:id="@+id/video_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="240dp"
        android:background="@drawable/zoom_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView android:id="@+id/chip_vres" style="@style/ProChip" android:text="1080p" />
        <TextView android:id="@+id/chip_vfps" style="@style/ProChip" android:text="30fps" />
        <TextView android:id="@+id/chip_vcodec" style="@style/ProChip" android:text="H264" />
        <TextView android:id="@+id/chip_tl" style="@style/ProChip" android:text="⏱ TL" />
    </LinearLayout>

    <!-- Barra de opciones desplazable (horizontal), encima de FOTO/VIDEO -->
    <HorizontalScrollView
        android:id="@+id/options_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="176dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/chip_grid" style="@style/ProChip" android:text="⊞" />
            <TextView android:id="@+id/chip_timer" style="@style/ProChip" android:text="⏱ off" />
            <TextView android:id="@+id/chip_flash" style="@style/ProChip" android:text="⚡ off" />
            <TextView android:id="@+id/chip_night" style="@style/ProChip" android:text="🌙" />
            <TextView android:id="@+id/chip_qr" style="@style/ProChip" android:text="QR" />
            <TextView android:id="@+id/chip_raw" style="@style/ProChip" android:text="RAW" />
            <TextView android:id="@+id/chip_filter" style="@style/ProChip" android:text="✦ Normal" />
            <TextView android:id="@+id/pro_toggle" style="@style/ProChip" android:text="PRO" />
            <TextView android:id="@+id/chip_ratio" style="@style/ProChip" android:text="4:3" />
            <TextView android:id="@+id/chip_res" style="@style/ProChip" android:text="FULL" />
            <TextView android:id="@+id/chip_lenses" style="@style/ProChip" android:text="LENTES" />
            <TextView android:id="@+id/chip_vid" style="@style/ProChip" android:text="🎬 HD" android:visibility="gone" />
            <TextView android:id="@+id/chip_flip" style="@style/ProChip" android:text="⟲ atrás" />

            <ImageButton
                android:id="@+id/btn_change_lens"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_lens"
                android:padding="10dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Cuenta atrás del temporizador -->
    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text=""
        android:textColor="@color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:shadowColor="#B3000000"
        android:shadowRadius="12"
        android:visibility="gone" />

    <!-- Resultado de QR / código de barras -->
    <LinearLayout
        android:id="@+id/qr_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/zoom_pill_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/qr_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView android:id="@+id/btn_qr_copy" style="@style/ProChip" android:text="Copiar" />
            <TextView android:id="@+id/btn_qr_open" style="@style/ProChip" android:text="Abrir" />
            <TextView android:id="@+id/btn_qr_close" style="@style/ProChip" android:text="Cerrar" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicador de procesado del modo noche -->
    <TextView
        android:id="@+id/night_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/zoom_pill_bg"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:text="🌙 Apilando…"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- 10. Destello de captura (encima de todo, no recibe toques) -->
    <View
        android:id="@+id/screen_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
