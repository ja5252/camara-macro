<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:padding="1dp">

    <!-- Las cien celdas del carrete reutilizaban cd_thumbnail ("Ver última foto"), que es
         la acción del botón de OTRA pantalla: el lector anunciaba una acción falsa.
         cd_media_cell ("Abrir") al menos dice lo que la celda hace de verdad, pero es un
         valor FIJO del layout: sigue siendo el mismo en las cien celdas, así que el
         carrete todavía no se puede navegar a ciegas (no hay forma de saber en cuál
         estás). Esto de aquí es solo el respaldo por si el enlace no lo pisa.
         Lo que falta es una descripción POR CELDA, y eso lo tiene que poner quien enlaza:
         en GalleryActivity.GridAdapter.onBindViewHolder, junto al resto del enlazado,
             holder.b.cellImage.contentDescription = getString(
                 if (item.isVideo) R.string.cd_media_cell_video else R.string.cd_media_cell_foto,
                 position + 1, items.size)
         con las cadenas cd_media_cell_foto / cd_media_cell_video que ya están en
         strings.xml esperando ("Foto %1$d de %2$d"). -->
    <ImageView
        android:id="@+id/cell_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#11FFFFFF"
        android:contentDescription="@string/cd_media_cell"
        android:scaleType="centerCrop" />

    <!-- Distintivo decorativo dibujado ENCIMA de la celda: el clic lo recibe la celda
         entera, así que anunciarlo aparte añadía una parada de foco por cada vídeo. -->
    <ImageView
        android:id="@+id/cell_play"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_play"
        android:visibility="gone" />
</FrameLayout>
