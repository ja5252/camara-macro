<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:padding="1dp">

    <!-- Las cien celdas del carrete reutilizaban cd_thumbnail ("Ver última foto"), así
         que el lector decía exactamente lo mismo en todas y el carrete no se podía
         navegar: no había forma de saber en cuál estabas. -->
    <ImageView
        android:id="@+id/cell_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#11FFFFFF"
        android:contentDescription="@string/cd_media_cell"
        android:scaleType="centerCrop" />

    <!-- Distintivo decorativo dibujado ENCIMA de la celda: el clic lo recibe la celda
         entera, así que anunciarlo aparte añadía una parada de foco por cada vídeo. -->
    <ImageView
        android:id="@+id/cell_play"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_play"
        android:visibility="gone" />
</FrameLayout>
