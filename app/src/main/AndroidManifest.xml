<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Solo se usa en Android 9 o anterior; en Android 10+ no hace falta para guardar en la galería -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Leer la galería integrada (también ver fotos tras reinstalar la app) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CamaraMacro">

        <!--
            configChanges: al plegar y desplegar cambian screenLayout y smallestScreenSize,
            y eran justo los dos que faltaban. Sin ellos el sistema DESTRUÍA la Activity al
            abrir el teléfono: se cerraba y se reabría la cámara (539-572 ms de pantalla en
            negro medidos) y se perdían el zoom, el modo y los ajustes en curso. Es la causa
            directa del "se siente lenta" en la pantalla grande, y no era lentitud: era un
            reinicio completo. GalleryActivity ya los declaraba; esta no.
            density y uiMode se añaden por el mismo motivo: en ColorOS el modo oscuro y el
            tamaño de fuente también recrean la Activity con la cámara abierta.
            CameraActivity.onConfigurationChanged reajusta el visor SIN cerrar el CameraDevice.
        -->
        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Permite que el sistema la ofrezca como app de cámara predeterminada -->
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Captura a petición de OTRA app (banca, archivos, formularios...).
                 OJO: declarar esto obliga a devolver el resultado correctamente; si no,
                 la app que lo invoca se queda colgada. El manejo está en CameraActivity. -->
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Muchas apps NO usan IMAGE_CAPTURE sino GET_CONTENT/PICK para pedir una
                 imagen (adjuntar documento en WhatsApp, formularios, subidas web...).
                 Apareciendo aquí podemos ofrecer "tomar la foto ahora" con la lente buena. -->
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- El asistente de elección de lente tiene una cámara abierta en vivo: si se
             recrea al plegar, se pierde la lente que el usuario estaba mirando. -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden" />

        <!-- Entrega de la foto a otras apps por content:// con permiso temporal -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.CamaraMacro" />
    </application>
</manifest>
